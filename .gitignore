## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/

# Environment variables
.env
.env.local
.env.production

# Startup scripts with credentials
start-production.sh
start-production.local.sh

# Secrets
appsettings.*.json
!appsettings.json
# Production config now contains real secrets - do not commit
# !appsettings.Production.json

# Database
*.db
*.db-shm
*.db-wal

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
