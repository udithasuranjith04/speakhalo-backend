# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=speakhalo
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
JWT_ISSUER=SpeakHalo
JWT_AUDIENCE=SpeakHaloUsers

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@speakhalo.com
SENDGRID_FROM_NAME=SpeakHalo

# Lemon Squeezy (Payment Provider)
# Get these from: https://app.lemonsqueezy.com
# 1. Settings → API → Create API Key
# 2. Settings → Webhooks → Signing Secret
# 3. Settings → General → Store ID
LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
LEMONSQUEEZY_STORE_ID=your_store_id

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=/path/to/credentials.json

# Redis (Optional)
REDIS_CONNECTION_STRING=localhost:6379

# Hangfire
HANGFIRE_DASHBOARD_LOGIN=admin
HANGFIRE_DASHBOARD_PASSWORD=your_secure_password

# Logging
SERILOG_MINIMUM_LEVEL=Information
